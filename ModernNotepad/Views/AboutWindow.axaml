<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModernNotepad.Views.AboutWindow"
        Title="About ModernNotepad"
        Width="300" Height="200"
        CanResize="False"
        TransparencyLevelHint="AcrylicBlur"
        Background="#1E1E1E">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
    <TextBlock Text="ModernNotepad" FontSize="24" FontWeight="Bold" Foreground="White"/>
    <TextBlock Text="Version 1.0" Foreground="White"/>
    <TextBlock Text="Created with Avalonia" Foreground="White"/>
  </StackPanel>
</Window>
